services:
  kanban-postgres:
    image: postgres:13-alpine
    container_name: kanban-postgres
    environment:
      POSTGRES_DB: kanban
      POSTGRES_USER: kanban
      POSTGRES_PASSWORD: kanban
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U kanban -d kanban"]
      interval: 5s
      timeout: 3s
      retries: 5
    networks:
      - kanban-net

  kanban-app:
    build: https://github.com/TheL0liDragon/kanban-backend.git
    container_name: kanban-app
    ports:
      - "8081:8080"
    depends_on:
      kanban-postgres:
        condition: service_healthy
    networks:
      - kanban-net

  frontend:
    build: https://github.com/TheL0liDragon/kanban-frontend.git
    container_name: frontend
    ports:
      - "8080:80"
    depends_on:
      - kanban-app
    networks:
      - kanban-net
networks:
  kanban-net:
    driver: bridge